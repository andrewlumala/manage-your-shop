# Copy this file to .env and fill in your own Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
#
# Leave these unset/blank and the app works fine on its own — it just falls
# back to storing data in this browser only, with no cross-device sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
